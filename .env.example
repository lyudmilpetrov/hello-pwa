# Copy this file to .env.local for optional frontend/development settings.
# npm run dev starts the frontend and standalone receipt API; no settings are required.

# Override the local API port for both the dev runner and Vite proxy.
# API_PORT=3001

# To use the deployed Worker through Vite instead of starting the local API,
# put this in .env.development.local (applies only to npm run dev):
# RECEIPT_API_PROXY_TARGET=https://taxes-receipt-api.taxes-kyrgyzstan.workers.dev
# VITE_RECEIPT_API_BASE_URL=
# Leave the browser URL empty so imports use Vite's same-origin proxy.
# Remove RECEIPT_API_PROXY_TARGET to return to the local Node API.

# For a frontend hosted separately from the receipt API:
# VITE_RECEIPT_API_BASE_URL=https://receipts.example.com/

# Optional frontend path (also used by the combined production server).
# BASE_PATH=/hello-pwa/

# Configure the standalone API in backend/.env; see backend/.env.example.

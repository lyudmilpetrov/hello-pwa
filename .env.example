# Local development includes the receipt API; no settings are required.

# For a frontend hosted separately from the receipt API:
# VITE_RECEIPT_API_BASE_URL=https://receipts.example.com/
# RECEIPT_ALLOWED_ORIGINS=https://lyudmilpetrov.github.io

# Optional Node server configuration. BASE_PATH must match the frontend build.
# BASE_PATH=/hello-pwa/
# HOST=0.0.0.0
# PORT=3000
